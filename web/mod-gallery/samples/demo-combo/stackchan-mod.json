{
  "$schema": "https://stack-chan.github.io/stack-chan/web/schemas/stackchan-mod.schema.json",
  "format": "tech.stackchan.mod",
  "schemaVersion": 1,
  "id": "tech.stackchan.samples.demo-combo",
  "version": "1.8.0",
  "type": "text",
  "name": "天気予報デモ",
  "description": "処理後に数秒でニュートラル復帰。漢字ふきだし+ひらがな発話。版:neutral-restore-1",
  "author": "Stack-chan Community",
  "license": "Apache-2.0",
  "source": {
    "path": "mod/manifest.json",
    "entrypoint": "mod/mod.js"
  },
  "targets": [
    "m5stackchan-cores3"
  ],
  "capabilities": [
    "face",
    "audio.speech",
    "motion",
    "ui.drawer",
    "connectivity.network"
  ],
  "artifacts": [
    {
      "format": "xsa",
      "path": "demo-combo.xsa",
      "target": "m5stackchan-cores3"
    }
  ]
}
