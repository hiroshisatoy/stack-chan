{
  "$schema": "https://stack-chan.github.io/stack-chan/web/schemas/stackchan-mod.schema.json",
  "format": "tech.stackchan.mod",
  "schemaVersion": 1,
  "id": "tech.stackchan.samples.demo-combo",
  "version": "1.0.0",
  "type": "text",
  "name": "天気予報デモ",
  "description": "Open-Meteoから東京の天気予報を取得してしゃべります。起動後に自動で天気を読み上げ、ドロワーの「天気」からも再実行できます。Wi-Fi接続が必要です。物理ボタンは使いません。",
  "author": "Stack-chan Community",
  "license": "Apache-2.0",
  "source": {
    "path": "mod/manifest.json",
    "entrypoint": "mod/mod.js"
  },
  "targets": ["m5stackchan-cores3"],
  "capabilities": ["face", "audio.speech", "motion", "ui.drawer", "connectivity.network"],
  "artifacts": [
    {
      "format": "xsa",
      "path": "demo-combo.xsa",
      "target": "m5stackchan-cores3"
    }
  ]
}
